{
    "useTabs": false,
    "tabWidth": 4,
    "printWidth": 160,
    "singleQuote": true,
    "jsxSingleQuote": true,
    "trailingComma": "none",
    "semi": false,
    "arrowParens": "avoid",
    "objectWrap": "preserve",
    "endOfLine": "auto",
    "overrides": [
        {
            "files": "*.{json,jsonc}",
            "options": {
                "tabWidth": 4
            }
        }
    ]
}
